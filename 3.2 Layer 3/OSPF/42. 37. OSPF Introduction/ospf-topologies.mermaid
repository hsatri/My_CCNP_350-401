graph TD
    %% Broadcast Network
    subgraph Broadcast
        B1[R1]
        B2[R2/DR]
        B3[R3/BDR]
        B4[R4]
        B1 --- B2
        B1 --- B3
        B1 --- B4
        B2 --- B3
        B2 --- B4
        B3 --- B4
    end

    %% Non-Broadcast Network
    subgraph NonBroadcast
        N1[R1]
        N2[R2/DR]
        N3[R3/BDR]
        N4[R4]
        N1 -.- N2
        N1 -.- N3
        N1 -.- N4
        N2 -.- N3
        N2 -.- N4
        N3 -.- N4
    end

    %% Point-to-Multipoint
    subgraph PointToMultipoint
        P1[R1/Hub]
        P2[R2/Spoke]
        P3[R3/Spoke]
        P4[R4/Spoke]
        P1 --- P2
        P1 --- P3
        P1 --- P4
    end

    %% Point-to-Multipoint Non-Broadcast
    subgraph PointToMultipointNB
        PM1[R1/Hub]
        PM2[R2/Spoke]
        PM3[R3/Spoke]
        PM4[R4/Spoke]
        PM1 -.- PM2
        PM1 -.- PM3
        PM1 -.- PM4
    end

    %% Point-to-Point
    subgraph PointToPoint
        PP1[R1]
        PP2[R2]
        PP1 --- PP2
    end

    %% Legend
    subgraph Legend
        L1[Automatic Discovery] --- L2[Manual Config]
        L2 -.- L3[Manual Config]
    end
